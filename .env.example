# Populate DATABASE_URL locally from a secure secret source; never commit credentials.
DATABASE_URL=
ATLAS_ADDR=:8080

# Bounded in-flight and fixed-window request limits.
ATLAS_MAX_CONCURRENT_REQUESTS=256
ATLAS_RATE_LIMIT_PER_KEY=120
ATLAS_RATE_LIMIT_PER_IP=600
ATLAS_RATE_LIMIT_WINDOW=1m
ATLAS_RATE_LIMIT_MAX_CLIENTS=10000
# Set either identity rate to 0 to disable it; concurrency must remain positive.

# Provision API keys with: go run ./cmd/atlas provision-key --name <name> --role <reader|writer|admin>
# Store the one-time output in your approved secret manager, not in this file.
